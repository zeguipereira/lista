#include <stdio.h>

Ex 1

int fatorial(int n) {
    if (n == 0 || n == 1) {
        return 1;
    }
  
    return n * fatorial(n - 1);
}
int main() {
    int n;
    printf("Digite um número inteiro não negativo: ");
    scanf("%d", &n);
    
    if (n < 0) {
        printf("Fatorial não é definido para números negativos.\n");
    } else {
        printf("Fatorial de %d é %d\n", n, fatorial(n));
    }

    return 0;
}
