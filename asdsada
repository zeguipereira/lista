#include <stdio.h>

int potencia(int x, int n) {
    if (n == 0) {
        return 1;
    }
    if (n % 2 == 0) {
        int half = potencia(x, n / 2);
        return half * half;
    } else {
        return x * potencia(x, n - 1);
    }
}

int main() {
    int x, n;
    printf("Digite a base (x): ");
    scanf("%d", &x);
    printf("Digite o expoente (n): ");
    scanf("%d", &n);
    
    printf("%d elevado a %d é %d\n", x, n, potencia(x, n));
    return 0;
}
